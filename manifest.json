{
  "manifest_version": 3,
  "name": "Hype Meter for YouTube",
  "version": "1.0.0",
  "description": "Shows how many Hype points a YouTube video has, in a small pill next to the like and dislike buttons.",
  "homepage_url": "https://github.com/ZIGAG1999/youtube-hype-meter",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["hype.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hype-meter@zigag1999",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  }
}
